{
  "name": "ricozedu",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @ricozedu/api test:e2e",
    "migrate": "pnpm --filter @ricozedu/api migrate",
    "migrate:down": "pnpm --filter @ricozedu/api migrate:down"
  },
  "devDependencies": {
    "pnpm": "9.15.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
