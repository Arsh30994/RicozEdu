NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ricozedu
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/ricozedu
DATABASE_MIGRATE_URL=postgresql://postgres:your-password@localhost:5432/ricozedu
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-token-change-me
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Google Identity Services OAuth 2.0 Web client ID (public identifier, not a secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
AI_PROVIDER=disabled
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OMNIDIM_API_KEY=your-omnidimension-api-key
OMNIDIM_AGENT_ID=your-omnidimension-agent-id
